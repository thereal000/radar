# Copy this file to `.env.local` in the project root and fill in your values.
# `.env.local` is gitignored — never commit real tokens.

# From @BotFather on Telegram (`/newbot`).
TELEGRAM_BOT_TOKEN=

# Your own chat id: message your bot once, then read
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and take `message.chat.id`.
TELEGRAM_CHAT_ID=
